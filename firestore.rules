rules_version = '2';

/*
  Firestore security rules for Bharat Connect 2026.

  Collections (everything not listed here is denied):

    registrations/{ref}     delegate passes, startup showcase and collaboration requests,
                            stored under their reference (BMF.BC-DGO-00001 …) with the full form in `details`
    queries/{ref}           helpdesk inquiries (BMF.BC-QRY-…)
    counters/{code}         last reference number for DGO, SEO, CBC and QRY
    logins/{autoId}         sign-in / sign-up / sign-out log shown in the admin panel
    startupDirectory/{ref}  public card of each APPROVED startup (the Startups page)
    admins/{email}          who may open the admin panel; added by hand in the Firebase console,
                            one document per admin, named with their email in lower case

  Who is who:
    - Registering (delegate, startup, collaboration) needs an account: Google, Apple or email.
      Visitors who only send an inquiry get an anonymous session behind the scenes.
    - Admins sign in with Google and must have a document in `admins`.

  What the rules guarantee:
    - Only admins read other people's submissions or the sign-in log, and only admins change a status.
    - A visitor creates a submission only as themselves, as "pending"/"received", at server time,
      with known fields at sane sizes, and under the next reference number (the counter and the
      record are written together, and the counter can only go up by one).
    - Nobody can edit or delete a submission after sending it, except an admin.
    - The startup directory is public but holds only public fields, and only admins write it.

  Not covered by rules: spam and flooding. Turn on Firebase App Check for Firestore before launch.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    // a Google or email account, not an anonymous visitor
    function hasAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // admins: the emails listed here, plus any added as documents in the `admins` collection
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && (request.auth.token.email.lower() in ['aryamansaxena04@gmail.com', 'surishri03@gmail.com']
            || exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }

    function str(v, max) {
      return v is string && v.size() <= max;
    }

    function filled(v, max) {
      return str(v, max) && v.size() > 0;
    }

    function isEmail(v) {
      return str(v, 254) && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function optStr(d, k, max) {
      return !(k in d) || str(d[k], max);
    }

    function optBool(d, k) {
      return !(k in d) || d[k] is bool;
    }

    // the complete form as submitted; the admin panel shows it field by field
    function optDetails(d) {
      return !('details' in d) || (d.details is map && d.details.size() <= 80);
    }

    // the record's reference must be the number the counter was moved to in the same write
    function takesNextRef(ref, code) {
      return ref.matches('^BMF\\.BC-' + code + '-[0-9]{5}$')
        && getAfter(/databases/$(database)/documents/counters/$(code)).data.n == int(ref.split('-')[2]);
    }

    // ── Reference counters ──────────────────────────────

    match /counters/{code} {
      allow get: if signedIn() && code in ['DGO', 'SEO', 'CBC', 'QRY'];
      allow create: if signedIn() && code in ['DGO', 'SEO', 'CBC', 'QRY']
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    // ── Registrations: delegate, startup, collaboration ───

    function validProfile(p) {
      return p is map
        && p.keys().hasOnly(['brand', 'sectors', 'stage', 'website', 'pitch'])
        && optStr(p, 'brand', 200)
        && (!('sectors' in p) || (p.sectors is list && p.sectors.size() <= 12))
        && optStr(p, 'stage', 60)
        && optStr(p, 'website', 300)
        && optStr(p, 'pitch', 1000);
    }

    function validNewRegistration(ref, d) {
      return d.keys().hasOnly([
          'ref', 'type', 'uid', 'status', 'submittedAt', 'accountEmail',
          'name', 'email', 'organisation', 'country', 'detail', 'sector', 'phone',
          'designation', 'dealSize', 'b2b', 'visaLetter', 'payment', 'profile', 'details'
        ])
        && d.type in ['delegate', 'startup', 'collaboration']
        && d.ref == ref
        && takesNextRef(ref, {'delegate': 'DGO', 'startup': 'SEO', 'collaboration': 'CBC'}[d.type])
        && d.uid == request.auth.uid
        && d.status == 'pending'
        && d.submittedAt == request.time
        // every registration portal needs a real account (Google, Apple or email)
        && hasAccount()
        && filled(d.name, 120)
        && isEmail(d.email)
        && optStr(d, 'accountEmail', 254)
        && optStr(d, 'organisation', 200)
        && optStr(d, 'country', 80)
        && optStr(d, 'detail', 200)
        && optStr(d, 'sector', 300)
        && optStr(d, 'phone', 30)
        && optStr(d, 'designation', 120)
        && optStr(d, 'dealSize', 60)
        && optBool(d, 'b2b')
        && optBool(d, 'visaLetter')
        && optStr(d, 'payment', 120)
        && (!('profile' in d) || validProfile(d.profile))
        && optDetails(d);
    }

    // an admin approves, declines or resets; nothing else on the record changes
    function validDecision(statuses) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'decidedAt', 'decidedBy'])
        && d.status in statuses
        && d.decidedAt == request.time
        && d.decidedBy == request.auth.uid
        && optStr(d, 'note', 1000);
    }

    match /registrations/{ref} {
      // the admin panel lists everything; a visitor reads only their own (query with where uid == their uid)
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && validNewRegistration(ref, request.resource.data);
      allow update: if isAdmin() && validDecision(['pending', 'approved', 'declined']);
      allow delete: if isAdmin();
    }

    // ── Helpdesk inquiries ─────────────────────────────

    function validNewQuery(ref, d) {
      return d.keys().hasOnly([
          'ref', 'uid', 'status', 'submittedAt',
          'fullName', 'email', 'phone', 'organization', 'country', 'regId',
          'category', 'dept', 'subject', 'message', 'urgent'
        ])
        && d.ref == ref
        && takesNextRef(ref, 'QRY')
        && d.uid == request.auth.uid
        && d.status == 'received'
        && d.submittedAt == request.time
        && filled(d.fullName, 120)
        && isEmail(d.email)
        && filled(d.message, 5000)
        && optStr(d, 'phone', 30)
        && optStr(d, 'organization', 200)
        && optStr(d, 'country', 80)
        && optStr(d, 'regId', 40)
        && optStr(d, 'category', 80)
        && optStr(d, 'dept', 120)
        && optStr(d, 'subject', 200)
        && optBool(d, 'urgent');
    }

    match /queries/{ref} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && validNewQuery(ref, request.resource.data);
      allow update: if isAdmin() && validDecision(['received', 'in-progress', 'answered', 'closed']);
      allow delete: if isAdmin();
    }

    // ── Sign-in log ─────────────────────────────────────

    match /logins/{loginId} {
      allow read, delete: if isAdmin();
      // a visitor can only log their own sign-in, with their own account email, at server time
      allow create: if hasAccount()
        && request.resource.data.keys().hasOnly(['uid', 'action', 'name', 'email', 'method', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.action in ['sign-in', 'sign-up', 'sign-out']
        && request.resource.data.method in ['Google', 'Apple', 'Email']
        && str(request.resource.data.name, 120)
        && request.resource.data.at == request.time;
    }

    // ── Public startup directory ────────────────────────

    match /startupDirectory/{ref} {
      allow read: if true;
      // written by an admin when approving a startup; public fields only, never contact details
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'sectors', 'stage', 'website', 'pitch', 'ref', 'approvedAt'])
        && filled(request.resource.data.name, 200)
        && (!('sectors' in request.resource.data) || (request.resource.data.sectors is list && request.resource.data.sectors.size() <= 12))
        && optStr(request.resource.data, 'stage', 60)
        && (!('website' in request.resource.data) || request.resource.data.website == ''
            || (str(request.resource.data.website, 300) && request.resource.data.website.matches('^https?://.+')))
        && optStr(request.resource.data, 'pitch', 1000)
        && optStr(request.resource.data, 'ref', 40);
      allow delete: if isAdmin();
    }

    // ── Admin list ──────────────────────────────────────

    match /admins/{email} {
      // an account may check whether it is itself an admin; the list is edited only in the console
      allow get: if signedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email;
    }
  }
}
